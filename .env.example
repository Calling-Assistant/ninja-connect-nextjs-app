# Copy this file to .env and fill in your values.
# In production, set these as environment variables in your hosting provider.

# Firebase Default Config (used for "Reset to Default" in Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Web Push — VAPID keys (run: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private key — server-side only (never expose to client)
VAPID_PRIVATE_KEY=
# Contact email or URL shown in push requests (required by VAPID spec)
VAPID_SUBJECT=mailto:admin@example.com

# Secret header required to call /api/send-notification and /api/incoming-call-push
# from external systems (e.g. your SIP backend).
# Requests from the same-origin web app are exempt from this check.
#
# SIP BACKEND INTEGRATION (for true closed-app push delivery):
#   When your PBX/SIP server receives an incoming call, POST to:
#   POST https://<your-domain>/api/incoming-call-push
#   Headers: Content-Type: application/json
#            X-Notification-Secret: <this value>
#   Body:    { "mobile": "<caller-number>", "username": "<caller-name>" }
#
#   This pushes a Web Push notification to ALL registered devices so those
#   with the app completely closed also get the system notification + ringtone.
NOTIFICATION_SECRET=

# Firebase Database Secret for server-side reads (Firebase Console → Project Settings → Service Accounts → Database secrets)
FIREBASE_DATABASE_SECRET=

# Google OAuth Client ID (for Google Contacts sync)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# App Defaults
NEXT_PUBLIC_EMERGENCY_PIN=
NEXT_PUBLIC_DEFAULT_PROFILE_NAME="Ganesh Kulkarni"
NEXT_PUBLIC_DEFAULT_PROFILE_NUMBER=9689698885
NEXT_PUBLIC_DEFAULT_INTRO_MESSAGE="Hi, I’m Ganesh Kulkarni from Bpointer Technologies.\nWe specialize in website and mobile app development. \nYou can view my profile here: https://vcard-2b71a.web.app"
